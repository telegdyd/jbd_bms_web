# Copy to .env. Every one of these already has a working default — change what you care about.

# Where the service listens. A bare port listens on every interface; prefix an address to pin it
# to one, e.g. 192.168.1.10:8080
BMS_BIND=8080

# Leave empty for no authentication. If you set it, the phone must send the same value.
BMS_UPLOAD_TOKEN=

# Uploads larger than this are rejected, so a wrong URL pointed here cannot fill the disk.
BMS_MAX_UPLOAD_MB=256

# Container log timestamps only. Recordings carry their own UTC offset.
TZ=Europe/Budapest
