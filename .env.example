# Only needed for `docker compose` on the command line. Portainer does NOT read this file —
# set the same names in the stack's own "Environment variables" box instead, or leave them
# alone, because every one of them has a working default.

# Host port. To listen on one interface only, edit the `ports:` line in docker-compose.yml
# directly and write it in full: "192.168.1.10:8080:8000".
BMS_PORT=8080

# Leave empty for no authentication. If you set it, the phone must send the same value.
BMS_UPLOAD_TOKEN=

# Uploads larger than this are rejected, so a wrong URL pointed here cannot fill the disk.
BMS_MAX_UPLOAD_MB=256

# Container log timestamps only. Recordings carry their own UTC offset.
TZ=Europe/Budapest
